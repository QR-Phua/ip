<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="CENTER_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
         prefWidth="420.0" spacing="10"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" wrapText="true" maxWidth="280.0" minHeight="-Infinity">
            <padding>
                <Insets bottom="10.0" left="14.0" right="14.0" top="10.0"/>
            </padding>
        </Label>
        <ImageView fx:id="displayPicture" fitHeight="44.0" fitWidth="44.0"
                   pickOnBounds="true" preserveRatio="true"/>
    </children>
    <padding>
        <Insets bottom="4.0" left="10.0" right="10.0" top="4.0"/>
    </padding>
</fx:root>
